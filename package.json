{
  "name": "twoeasy",
  "productName": "TwoEasy - Editor for the AI era",
  "version": "0.5.4",
  "description": "TwoEasy",
  "main": "main.js",
  "author": "Andrea Gerali",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:ui": "esbuild src/code-entry.js --bundle --format=iife --minify --outdir=src/vendor --entry-names=code && esbuild src/wysiwyg-entry.js --bundle --format=iife --minify --outdir=src/vendor --entry-names=wysiwyg --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --asset-names=fonts/[name] && esbuild node_modules/@milkdown/crepe/lib/theme/crepe-dark/style.css --bundle --minify --outdir=src/vendor --entry-names=wysiwyg-dark --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --asset-names=fonts/[name]",
    "predist": "npm run build:ui",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "docx": "^9.13.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "mathml2omml": "^0.5.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "it.gerali.twoeasy",
    "productName": "TwoEasy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
    "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "role": "Editor"
      }
    ]
  }
}
